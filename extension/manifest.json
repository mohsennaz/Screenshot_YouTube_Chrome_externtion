{
    "manifest_version": 3,
    "name": "Screenshot YouTube",
    "version": "3.2.0",

    "description": "Take screenshots of YouTube videos manually or automatically and send to Telegram and/or a local app.",
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },

    "options_page": "options.html",
    
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["page.js"],
            "css": ["style.css"],
            "run_at": "document_end"
        }
    ],

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "https://api.telegram.org/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
    ]
}